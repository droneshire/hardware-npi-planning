rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /user/{email} {
      function isAdmin(request) {
        return request.auth != null && request.auth.token.email == "ryeager12@gmail.com";
      }
      // Allow users to create, read, and update their own document
      allow create, read, update: if request.auth != null && request.auth.token.email == email;
      // Admins can do everything
      allow create, read, update, delete: if isAdmin(request);
      // Allow access in development/emulator mode (when auth is null)
      // NOTE: This is for development only. In production, use Firebase Admin SDK for server-side operations.
      allow read, write: if request.auth == null;
    }
    match /admin/{status} {
      function isAdmin(request) {
        return request.auth != null && request.auth.token.email == "ryeager12@gmail.com";
      }
      allow read, update: if isAdmin(request);
      // Allow access in development/emulator mode
      allow read, write: if request.auth == null;
    }
  }
}
